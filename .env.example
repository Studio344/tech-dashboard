# tech-dashboard ローカル実行用の環境変数サンプル。
# 実値は .env.local にコピーして設定する (.env.local は .gitignore 済み)。
# このファイルはプレースホルダーのみ。実トークンを書き込まないこと。

# ============ Anthropic Claude API (要約・本文・バックフィル) ============
# 唯一の LLM 経路 (GitHub Copilot は廃止)。実キーは .env.local にだけ書く。
# 未設定ならバックフィル系は明示エラーで終了し、npm run collect は要約をスキップする。
ANTHROPIC_API_KEY=__REPLACE_WITH_YOUR_ANTHROPIC_API_KEY__
# SUMMARIZE_MODEL=claude-opus-5-5   # claude-* のみ
# SUMMARIZE_EFFORT=medium           # low | medium | high | xhigh | max
# BODY_MODEL=claude-opus-5-5
# BODY_EFFORT=high

# ============ 要約チューニング (任意) ============
# ENQUEUE_MAX_NEW=10
# SUMMARIZE_TIMEOUT_MS=120000
# SUMMARIZE_MAX_TOKENS=16000
# SUMMARIZE_CONCURRENCY=2

# ============ 手動 Worker デプロイ / 運用 (任意) ============
# 通常は Cloudflare Pages Git Integration が自動デプロイするため不要 (R-001)。
# 手動デプロイ時のみ設定する。
# CLOUDFLARE_ACCOUNT_ID=__REPLACE_WITH_ACCOUNT_ID__
# CLOUDFLARE_API_TOKEN=__REPLACE_WITH_API_TOKEN__
# RUN_WORKER_DEPLOY=1   # pre-push で Worker deploy を明示的に有効化する (R-008)

# ============ Cloudflare Pages 匿名公開いいね ============
# Astro は build 時に公開 site key を読み込む。ローカル web build では
# web/.env.local、本番では Pages build variable に設定する。
PUBLIC_TURNSTILE_SITE_KEY=__REPLACE_WITH_TURNSTILE_SITE_KEY__

# Pages Functions の secret。ローカルでは web/.dev.vars、本番では
# Pages encrypted secret に設定する。
TURNSTILE_SECRET_KEY=__REPLACE_WITH_TURNSTILE_SECRET_KEY__
REACTION_HMAC_SECRET=__REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS__

# REACTIONS_DB は環境文字列ではなく Cloudflare Pages の D1 binding。
